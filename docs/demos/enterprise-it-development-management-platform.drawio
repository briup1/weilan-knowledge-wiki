<mxfile host="app.diagrams.net" modified="2026-09-23T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" pages="6"><diagram id="01-为什么需要平台" name="01-为什么需要平台"><mxGraphModel background="#F2EFE8" grid="0" tooltips="0" connect="1" arrows="1" fold="0" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="border" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF8F3;strokeColor=#B9B3AB;strokeWidth=1.5;fontColor=#1F1F1C;fontSize=20;verticalAlign=top;spacingTop=14;fontStyle=1;fillColor=none;pointerEvents=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="20" width="1614" height="1100" /></mxCell><mxCell id="title" value="问题一 · 企业为什么需要 Agent 管理平台？" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontStyle=1;fontSize=32;fontColor=#1F1F1C;" vertex="1" parent="1"><mxGeometry as="geometry" x="180" y="38" width="1294" height="52" /></mxCell><mxCell id="subtitle" value="当 Agent 从试点进入多团队、多数据域和生产环境，核心问题从“能否做出来”转为“能否规模化、可信地长期运行”" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=15;fontColor=#6E6962;" vertex="1" parent="1"><mxGeometry as="geometry" x="200" y="92" width="1254" height="30" /></mxCell><mxCell id="before" value="没有统一平台" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF8F3;strokeColor=#B9B3AB;strokeWidth=1.5;fontColor=#1F1F1C;fontSize=20;verticalAlign=top;spacingTop=14;fontStyle=1;strokeColor=#D96B63;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="155" width="480" height="760" /></mxCell><mxCell id="b0" value="&lt;b&gt;重复建设&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#6E6962&quot;&gt;模型、RAG、工具、审批、日志各做一套&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8E8E6;strokeColor=#D96B63;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="235" width="400" height="88" /></mxCell><mxCell id="b1" value="&lt;b&gt;治理断裂&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#6E6962&quot;&gt;身份、数据权限、成本、审计无法统一回答&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8E8E6;strokeColor=#D96B63;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="380" width="400" height="88" /></mxCell><mxCell id="b2" value="&lt;b&gt;生产失控&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#6E6962&quot;&gt;版本不清、失败难恢复、高风险动作无闸门&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8E8E6;strokeColor=#D96B63;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="525" width="400" height="88" /></mxCell><mxCell id="b3" value="&lt;b&gt;资产流失&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#6E6962&quot;&gt;经验留在项目中，第二个场景仍从零开始&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8E8E6;strokeColor=#D96B63;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="670" width="400" height="88" /></mxCell><mxCell id="trigger" value="平台化触发点" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2D2B28;strokeColor=#2D2B28;strokeWidth=1.8;fontColor=#FFFFFF;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="350" width="320" height="150" /></mxCell><mxCell id="trigger_text" value="多个 Agent 并行建设&lt;br&gt;开始进入真实生产&lt;br&gt;权限、成本与责任需要统一" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8E9E1;strokeColor=#D88966;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="620" y="525" width="280" height="135" /></mxCell><mxCell id="bt1" value="重复建设 + 治理断裂" style="endArrow=open;endSize=14;edgeStyle=orthogonalEdgeStyle;strokeColor=#D96B63;strokeWidth=1.8;rounded=1;fontSize=14;fontColor=#D96B63;" edge="1" parent="1" source="before" target="trigger"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="bt2" value="问题集中暴露" style="endArrow=open;endSize=14;edgeStyle=orthogonalEdgeStyle;strokeColor=#D88966;strokeWidth=1.8;rounded=1;dashed=1;dashPattern=6 6;fontSize=14;fontColor=#D88966;" edge="1" parent="1" source="trigger" target="trigger_text"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="after" value="建立统一平台" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF8F3;strokeColor=#B9B3AB;strokeWidth=1.5;fontColor=#1F1F1C;fontSize=20;verticalAlign=top;spacingTop=14;fontStyle=1;strokeColor=#7FB08F;" vertex="1" parent="1"><mxGeometry as="geometry" x="980" y="155" width="610" height="760" /></mxCell><mxCell id="g0" value="&lt;b&gt;统一运行底线&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#6E6962&quot;&gt;Runtime、身份、策略、Trace、评测契约&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#7FB08F;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1020" y="235" width="530" height="88" /></mxCell><mxCell id="g1" value="&lt;b&gt;能力资产复用&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#6E6962&quot;&gt;模型、工具、知识、工作流进入统一目录&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#7FB08F;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1020" y="380" width="530" height="88" /></mxCell><mxCell id="g2" value="&lt;b&gt;风险可控&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#6E6962&quot;&gt;授权、审批、版本、灰度、回滚、审计&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#7FB08F;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1020" y="525" width="530" height="88" /></mxCell><mxCell id="g3" value="&lt;b&gt;持续优化&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#6E6962&quot;&gt;质量、成本、效率有数据闭环，不再靠感觉&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#7FB08F;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1020" y="670" width="530" height="88" /></mxCell><mxCell id="ta" value="收口共性能力" style="endArrow=open;endSize=14;edgeStyle=orthogonalEdgeStyle;strokeColor=#7FB08F;strokeWidth=1.8;rounded=1;fontSize=14;fontColor=#6E6962;" edge="1" parent="1" source="trigger_text" target="after"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="why_claim" value="平台的价值不是“再造一个更大的 Agent”，而是让很多不同的 Agent 在同一条可信治理线上运行。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9A90D6;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="985" width="1170" height="72" /></mxCell></root></mxGraphModel></diagram><diagram id="02-需求接纳运行与价值" name="02-需求接纳运行与价值"><mxGraphModel background="#F2EFE8" grid="0" tooltips="0" connect="1" arrows="1" fold="0" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="border" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF8F3;strokeColor=#B9B3AB;strokeWidth=1.5;fontColor=#1F1F1C;fontSize=20;verticalAlign=top;spacingTop=14;fontStyle=1;fillColor=none;pointerEvents=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="20" width="1614" height="1100" /></mxCell><mxCell id="title" value="问题二 · 需求如何被接纳、运行，并产生新增价值？" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontStyle=1;fontSize=32;fontColor=#1F1F1C;" vertex="1" parent="1"><mxGeometry as="geometry" x="180" y="38" width="1294" height="52" /></mxCell><mxCell id="subtitle" value="需求不是直接进入开发，而是先转化为可评审、可运行、可治理、可退出的平台对象" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=15;fontColor=#6E6962;" vertex="1" parent="1"><mxGeometry as="geometry" x="200" y="92" width="1254" height="30" /></mxCell><mxCell id="d1" value="&lt;b&gt;1 需求接纳&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#6E6962&quot;&gt;目标 / Owner / KPI&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#6FA8D6;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="55" y="165" width="195" height="105" /></mxCell><mxCell id="d2" value="&lt;b&gt;2 适配与分级&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#6E6962&quot;&gt;是否适合 Agent&#10;复用 / 风险等级&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8E9E1;strokeColor=#D88966;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="280" y="165" width="195" height="105" /></mxCell><mxCell id="de1" value="" style="endArrow=open;endSize=14;edgeStyle=orthogonalEdgeStyle;strokeColor=#7A756E;strokeWidth=1.8;rounded=1;fontSize=14;fontColor=#6E6962;" edge="1" parent="1" source="d1" target="d2"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="d3" value="&lt;b&gt;3 方案注册&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#6E6962&quot;&gt;AgentSpec / Tool / Data&#10;Eval / Policy&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9A90D6;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="505" y="165" width="195" height="105" /></mxCell><mxCell id="de2" value="" style="endArrow=open;endSize=14;edgeStyle=orthogonalEdgeStyle;strokeColor=#7A756E;strokeWidth=1.8;rounded=1;fontSize=14;fontColor=#6E6962;" edge="1" parent="1" source="d2" target="d3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="d4" value="&lt;b&gt;4 沙盒构建&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#6E6962&quot;&gt;模板 / 测试 / 评测&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6E2DA;strokeColor=#8C867F;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="730" y="165" width="195" height="105" /></mxCell><mxCell id="de3" value="" style="endArrow=open;endSize=14;edgeStyle=orthogonalEdgeStyle;strokeColor=#7A756E;strokeWidth=1.8;rounded=1;fontSize=14;fontColor=#6E6962;" edge="1" parent="1" source="d3" target="d4"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="d5" value="&lt;b&gt;5 上线准入&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#6E6962&quot;&gt;安全 / 审批 / 版本&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8E9E1;strokeColor=#D88966;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="955" y="165" width="195" height="105" /></mxCell><mxCell id="de4" value="" style="endArrow=open;endSize=14;edgeStyle=orthogonalEdgeStyle;strokeColor=#7A756E;strokeWidth=1.8;rounded=1;fontSize=14;fontColor=#6E6962;" edge="1" parent="1" source="d4" target="d5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="d6" value="&lt;b&gt;6 生产运行&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#6E6962&quot;&gt;Runtime / HITL / Trace&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#7FB08F;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1180" y="165" width="195" height="105" /></mxCell><mxCell id="de5" value="" style="endArrow=open;endSize=14;edgeStyle=orthogonalEdgeStyle;strokeColor=#7A756E;strokeWidth=1.8;rounded=1;fontSize=14;fontColor=#6E6962;" edge="1" parent="1" source="d5" target="d6"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="d7" value="&lt;b&gt;7 运营迭代&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#6E6962&quot;&gt;成本 / 质量 / 事故&#10;优化 / 退役&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#7FB08F;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1405" y="165" width="195" height="105" /></mxCell><mxCell id="de6" value="" style="endArrow=open;endSize=14;edgeStyle=orthogonalEdgeStyle;strokeColor=#7A756E;strokeWidth=1.8;rounded=1;fontSize=14;fontColor=#6E6962;" edge="1" parent="1" source="d6" target="d7"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="runtime_panel" value="一次生产 Run 的受控执行链" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF8F3;strokeColor=#B9B3AB;strokeWidth=1.5;fontColor=#1F1F1C;fontSize=20;verticalAlign=top;spacingTop=14;fontStyle=1;strokeColor=#9A90D6;" vertex="1" parent="1"><mxGeometry as="geometry" x="90" y="345" width="1470" height="295" /></mxCell><mxCell id="r1" value="建立工作负载身份" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8E9E1;strokeColor=#D88966;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="145" y="445" width="185" height="70" /></mxCell><mxCell id="r2" value="加载受控上下文" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#6FA8D6;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="375" y="445" width="185" height="70" /></mxCell><mxCell id="re1" value="" style="endArrow=open;endSize=14;edgeStyle=orthogonalEdgeStyle;strokeColor=#7A756E;strokeWidth=1.8;rounded=1;fontSize=14;fontColor=#6E6962;" edge="1" parent="1" source="r1" target="r2"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="r3" value="Planner 提议下一步" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9A90D6;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="605" y="445" width="185" height="70" /></mxCell><mxCell id="re2" value="" style="endArrow=open;endSize=14;edgeStyle=orthogonalEdgeStyle;strokeColor=#7A756E;strokeWidth=1.8;rounded=1;fontSize=14;fontColor=#6E6962;" edge="1" parent="1" source="r2" target="r3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="r4" value="Policy 校验工具调用" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8E9E1;strokeColor=#D88966;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="835" y="445" width="185" height="70" /></mxCell><mxCell id="re3" value="" style="endArrow=open;endSize=14;edgeStyle=orthogonalEdgeStyle;strokeColor=#D88966;strokeWidth=1.8;rounded=1;dashed=1;dashPattern=6 6;fontSize=14;fontColor=#D88966;" edge="1" parent="1" source="r3" target="r4"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="r5" value="执行 / 人工介入" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6E2DA;strokeColor=#8C867F;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1065" y="445" width="185" height="70" /></mxCell><mxCell id="re4" value="" style="endArrow=open;endSize=14;edgeStyle=orthogonalEdgeStyle;strokeColor=#D88966;strokeWidth=1.8;rounded=1;dashed=1;dashPattern=6 6;fontSize=14;fontColor=#D88966;" edge="1" parent="1" source="r4" target="r5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="r6" value="结果 + Trace + 成本" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#7FB08F;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1295" y="445" width="185" height="70" /></mxCell><mxCell id="re5" value="" style="endArrow=open;endSize=14;edgeStyle=orthogonalEdgeStyle;strokeColor=#7A756E;strokeWidth=1.8;rounded=1;fontSize=14;fontColor=#6E6962;" edge="1" parent="1" source="r5" target="r6"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="runtime_feedback" value="长任务恢复 / 下一轮" style="endArrow=open;endSize=14;edgeStyle=orthogonalEdgeStyle;strokeColor=#8E8982;strokeWidth=1.8;rounded=1;dashed=1;dashPattern=6 6;fontSize=14;fontColor=#6E6962;" edge="1" parent="1" source="r6" target="r2"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1470" y="570" /><mxPoint x="240" y="570" /></Array></mxGeometry></mxCell><mxCell id="value_title" value="平台新增价值" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2D2B28;strokeColor=#2D2B28;strokeWidth=1.8;fontColor=#FFFFFF;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="90" y="710" width="210" height="220" /></mxCell><mxCell id="v0" value="&lt;b&gt;需求资产化&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#6E6962&quot;&gt;需求沉淀为 Agent、工具、数据、策略和评测契约&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#6FA8D6;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="330" y="710" width="215" height="105" /></mxCell><mxCell id="v1" value="&lt;b&gt;能力复用&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#6E6962&quot;&gt;后续场景复用模型、工具、知识和交付模板&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#7FB08F;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="575" y="710" width="215" height="105" /></mxCell><mxCell id="v2" value="&lt;b&gt;风险前置&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#6E6962&quot;&gt;高风险动作在执行前授权、审批与限制&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#6FA8D6;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="710" width="215" height="105" /></mxCell><mxCell id="v3" value="&lt;b&gt;证据闭环&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#6E6962&quot;&gt;每次运行可解释、可回放、可评测、可归责&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#6FA8D6;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1065" y="710" width="215" height="105" /></mxCell><mxCell id="v4" value="&lt;b&gt;组织复利&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#6E6962&quot;&gt;第二、第三个场景接入成本持续下降&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#7FB08F;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1310" y="710" width="215" height="105" /></mxCell><mxCell id="exit" value="没有 Owner、验收样本、数据授权或退出条件的需求，不应直接进入生产。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8E9E1;strokeColor=#D88966;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="300" y="965" width="1050" height="70" /></mxCell></root></mxGraphModel></diagram><diagram id="03-平台建设路径" name="03-平台建设路径"><mxGraphModel background="#F2EFE8" grid="0" tooltips="0" connect="1" arrows="1" fold="0" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="border" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF8F3;strokeColor=#B9B3AB;strokeWidth=1.5;fontColor=#1F1F1C;fontSize=20;verticalAlign=top;spacingTop=14;fontStyle=1;fillColor=none;pointerEvents=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="20" width="1614" height="1100" /></mxCell><mxCell id="title" value="问题三 · 构建企业级 Agent 管理平台的路径是什么？" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontStyle=1;fontSize=32;fontColor=#1F1F1C;" vertex="1" parent="1"><mxGeometry as="geometry" x="180" y="38" width="1294" height="52" /></mxCell><mxCell id="subtitle" value="先建立治理和运行闭环，再扩大智能能力；先验证复用价值，再追求平台规模" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=15;fontColor=#6E6962;" vertex="1" parent="1"><mxGeometry as="geometry" x="200" y="92" width="1254" height="30" /></mxCell><mxCell id="p0" value="&lt;b&gt;阶段 0&#10;边界与基线&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;确定 Owner、对象模型、风险红线&#10;盘点现有 Agent 与基础设施&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#6E6962&quot;&gt;产出：平台边界 + Agent Catalog 草案&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#6FA8D6;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="190" width="280" height="310" /></mxCell><mxCell id="p1" value="&lt;b&gt;阶段 1&#10;最小治理线&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;模型入口、Runtime、Tool Registry&#10;身份策略、基础 Trace、首个场景&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#6E6962&quot;&gt;验收：首个场景可运行、可追踪、可停止&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8E9E1;strokeColor=#D88966;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="365" y="190" width="280" height="310" /></mxCell><mxCell id="pe1" value="" style="endArrow=open;endSize=14;edgeStyle=orthogonalEdgeStyle;strokeColor=#7A756E;strokeWidth=1.8;rounded=1;fontSize=14;fontColor=#6E6962;" edge="1" parent="1" source="p0" target="p1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="p2" value="&lt;b&gt;阶段 2&#10;交付闭环&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;模板、评测、发布门禁、HITL&#10;版本、成本、管理工作台&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#6E6962&quot;&gt;验收：生产版本可评测、可回滚、可审计&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9A90D6;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="680" y="190" width="280" height="310" /></mxCell><mxCell id="pe2" value="" style="endArrow=open;endSize=14;edgeStyle=orthogonalEdgeStyle;strokeColor=#7A756E;strokeWidth=1.8;rounded=1;fontSize=14;fontColor=#6E6962;" edge="1" parent="1" source="p1" target="p2"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="p3" value="&lt;b&gt;阶段 3&#10;多场景复制&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;知识 / Memory、第二三业务线&#10;多租户、SLO、协议适配&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#6E6962&quot;&gt;验收：新场景不再重复搭底座&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#7FB08F;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="995" y="190" width="280" height="310" /></mxCell><mxCell id="pe3" value="" style="endArrow=open;endSize=14;edgeStyle=orthogonalEdgeStyle;strokeColor=#7A756E;strokeWidth=1.8;rounded=1;fontSize=14;fontColor=#6E6962;" edge="1" parent="1" source="p2" target="p3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="p4" value="&lt;b&gt;阶段 4&#10;平台化运营&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;自助目录、灰度优化、成本质量运营&#10;能力市场、退出与供应商可替换&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#6E6962&quot;&gt;验收：接入时间下降，质量与成本持续改善&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3EC;strokeColor=#7FB08F;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1310" y="190" width="280" height="310" /></mxCell><mxCell id="pe4" value="" style="endArrow=open;endSize=14;edgeStyle=orthogonalEdgeStyle;strokeColor=#7A756E;strokeWidth=1.8;rounded=1;fontSize=14;fontColor=#6E6962;" edge="1" parent="1" source="p3" target="p4"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="principles" value="建设顺序原则" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2D2B28;strokeColor=#2D2B28;strokeWidth=1.8;fontColor=#FFFFFF;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="590" width="250" height="310" /></mxCell><mxCell id="pr0" value="&lt;b&gt;先治理，后增强&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#6E6962&quot;&gt;身份 / 权限 / Trace / Eval 早于复杂 Memory 与多 Agent&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8E9E1;strokeColor=#D88966;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="360" y="590" width="260" height="120" /></mxCell><mxCell id="pr1" value="&lt;b&gt;先闭环，后铺开&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#6E6962&quot;&gt;先打通一个真实场景，再复制第二、第三个场景&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6E2DA;strokeColor=#8C867F;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="655" y="590" width="260" height="120" /></mxCell><mxCell id="pr2" value="&lt;b&gt;先契约，后门户&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#6E6962&quot;&gt;先统一对象、事件和策略，不以页面数量代表平台化&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6E2DA;strokeColor=#8C867F;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="950" y="590" width="260" height="120" /></mxCell><mxCell id="pr3" value="&lt;b&gt;先复用，后规模&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#6E6962&quot;&gt;平台化信号是后续接入少做重复工作&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6E2DA;strokeColor=#8C867F;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1245" y="590" width="260" height="120" /></mxCell><mxCell id="road_claim" value="最小可行平台不是功能最少的门户，而是能够让一个生产 Agent 被注册、授权、运行、评测、审计、回滚和退役的完整闭环。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEEAF9;strokeColor=#9A90D6;strokeWidth=1.8;fontColor=#1F1F1C;fontSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="250" y="970" width="1160" height="75" /></mxCell></root></mxGraphModel></diagram><diagram id="04-附录-能力全景" name="04-附录-能力全景"><mxGraphModel background="#F2EFE8" grid="0" tooltips="0" connect="1" arrows="1" fold="0" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="border" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF8F3;strokeColor=#B9B3AB;strokeWidth=1.5;fontColor=#1F1F1C;fontSize=20;verticalAlign=top;spacingTop=14;fontStyle=1;fillColor=none;pointerEvents=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="20" width="1614" height="1100" /></mxCell><mxCell id="title" value="企业 IT 开发管理平台 · 能力全景" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontStyle=1;fontSize=32;fontColor=#1F1F1C;" vertex="1" parent="1"><mxGeometry as="geometry" x="180" y="38" width="1294" height="52" /></mxCell><mxCell id="subtitle" value="四个平面承载研发全生命周期，三根支柱贯穿所有模块；AI / Agent 是扩展域而非孤岛" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=15;fontColor=#6E6962;" vertex="1" parent="1"><mxGeometry as="geometry" x="200" y="92" width="1254" height="30" /></mxCell><mxCell id="p1" value="1  开发者控制平面" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF8F3;strokeColor=#B9B3AB;strokeWidth=1.5;fontColor=#1F1F1C;fontSize=20;verticalAlign=top;spacingTop=14;fontStyle=1;strokeColor=#6FA8D6;" vertex="1" parent="1"><mxGeometry as="geometry" x="110" y="140" width="1230" height="130" /></mxCell><mxCell id="p1n0" value="&lt;b&gt;统一工作台&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#6E6962&quot;&gt;项目 / 需求&lt;/font&gt;" style="rounded=